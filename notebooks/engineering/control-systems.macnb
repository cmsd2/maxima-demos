814011805,1.0080461633425761,1.0078768371278621,1.0077093008044304,1.0075435521039209,1.0073795884489227,1.0072174069596045,1.0070570044602727,1.0068983774858589,1.006741522288336,1.0065864348430635,1.0064331108550615,1.0062815457652141,1.006131734756403,1.005983672759569,1.005837354459706,1.005692774301782,1.0055499264965932,1.0054088050265462,1.0052694036513723,1.0051317159137727,1.0049957351449945,1.0048614544703378,1.0047288668145953],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"red\",\"width\":2},\"name\":\"v_C(t) — voltage\"}],\"layout\":{\"title\":{\"text\":\"Step Response of RLC Circuit\"},\"showlegend\":true,\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"Time (s)\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"Amplitude\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
