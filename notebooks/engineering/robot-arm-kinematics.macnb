line\":{\"color\":\"black\",\"width\":2},\"opacity\":0.4,\"name\":\"r = 1.7\"}],\"layout\":{\"title\":{\"text\":\"Workspace of the Two-Link Arm (l1 = 1.0, l2 = 0.7)\"},\"showlegend\":false,\"width\":700,\"height\":700,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"scaleanchor\":\"x\",\"scaleratio\":1.0,\"title\":{\"text\":\"y\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
