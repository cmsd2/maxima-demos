idth\":3},\"name\":\"lines\"},{\"x\":[4.0,4.0],\"y\":[0.0,4.0],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"lightgray\",\"width\":3,\"dash\":\"dash\"},\"name\":\"lines\"},{\"x\":[4.025,4.175000000000002],\"y\":[-0.25571067811865633,3.754289321881344],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"steelblue\",\"width\":3},\"name\":\"lines\"},{\"x\":[8.0,8.0],\"y\":[0.0,4.0],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"lightgray\",\"width\":3,\"dash\":\"dash\"},\"name\":\"lines\"},{\"x\":[8.05,8.135000000000002],\"y\":[-0.4131370849898502,3.5818629150101495],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"crimson\",\"width\":3},\"name\":\"lines\"},{\"x\":[12.0,12.0],\"y\":[0.0,4.0],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"lightgray\",\"width\":3,\"dash\":\"dash\"},\"name\":\"lines\"},{\"x\":[12.09,12.09],\"y\":[-0.47727922061358136,3.5227207793864186],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"steelblue\",\"width\":3},\"name\":\"lines\"},{\"x\":[16.0,16.0],\"y\":[0.0,4.0],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"lightgray\",\"width\":3,\"dash\":\"dash\"},\"name\":\"lines\"},{\"x\":[16.130000000000003,16.045],\"y\":[-0.41313708498985,3.58186291501015],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"crimson\",\"width\":3},\"name\":\"lines\"},{\"x\":[20.0,20.0],\"y\":[0.0,4.0],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"lightgray\",\"width\":3,\"dash\":\"dash\"},\"name\":\"lines\"},{\"x\":[20.155,20.005],\"y\":[-0.25571067811865605,3.754289321881344],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"steelblue\",\"width\":3},\"name\":\"lines\"},{\"x\":[4.0,8.0],\"y\":[4.0,0.0],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"lightgray\",\"width\":3,\"dash\":\"dash\"},\"name\":\"lines\"},{\"x\":[4.175000000000002,8.05],\"y\":[3.754289321881344,-0.4131370849898502],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"steelblue\",\"width\":3},\"name\":\"lines\"},{\"x\":[8.0,12.0],\"y\":[4.0,0.0],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"lightgray\",\"width\":3,\"dash\":\"dash\"},\"name\":\"lines\"},{\"x\":[8.135000000000002,12.09],\"y\":[3.5818629150101495,-0.47727922061358136],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"steelblue\",\"width\":3},\"name\":\"lines\"},{\"x\":[16.0,12.0],\"y\":[4.0,0.0],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"lightgray\",\"width\":3,\"dash\":\"dash\"},\"name\":\"lines\"},{\"x\":[16.045,12.09],\"y\":[3.58186291501015,-0.47727922061358136],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"steelblue\",\"width\":3},\"name\":\"lines\"},{\"x\":[20.0,16.0],\"y\":[4.0,0.0],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"lightgray\",\"width\":3,\"dash\":\"dash\"},\"name\":\"lines\"},{\"x\":[20.005,16.130000000000003],\"y\":[3.754289321881344,-0.41313708498985],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"steelblue\",\"width\":3},\"name\":\"lines\"},{\"x\":[0.0,24.0],\"y\":[-0.4,-0.4],\"type\":\"scatter\",\"mode\":\"markers\",\"marker\":{\"color\":\"black\",\"size\":12,\"symbol\":\"triangle-up\"},\"name\":\"points\"}],\"layout\":{\"title\":{\"text\":\"Pratt Truss: Deformed Shape (x50), Forces in kN\"},\"showlegend\":false,\"width\":700,\"height\":700,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x (m)\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"y (m)\"},\"scaleanchor\":\"x\",\"scaleratio\":1.0,\"range\":[-1.5,5.5],\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"annotations\":[{\"text\":\"125\",\"x\":2.0125,\"y\":0.2221446609406718,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"steelblue\"}},{\"text\":\"125\",\"x\":6.0375000000000005,\"y\":0.01557611844574669,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"steelblue\"}},{\"text\":\"200\",\"x\":10.07,\"y\":-0.0952081528017158,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"steelblue\"}},{\"text\":\"200\",\"x\":14.110000000000001,\"y\":-0.09520815280171568,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"steelblue\"}},{\"text\":\"125\",\"x\":18.142500000000002,\"y\":0.015576118445746912,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"steelblue\"}},{\"text\":\"125\",\"x\":22.1675,\"y\":0.22214466094067195,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"steelblue\"}},{\"text\":\"-200\",\"x\":6.155000000000001,\"y\":4.018076118445746,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"crimson\"}},{\"text\":\"-225\",\"x\":10.1125,\"y\":3.9022918471982844,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"crimson\"}},{\"text\":\"-225\",\"x\":14.0675,\"y\":3.9022918471982844,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"crimson\"}},{\"text\":\"-200\",\"x\":18.025,\"y\":4.018076118445746,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"crimson\"}},{\"text\":\"-177\",\"x\":2.087500000000001,\"y\":2.227144660940672,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"crimson\"}},{\"text\":\"-177\",\"x\":22.0925,\"y\":2.227144660940672,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"crimson\"}},{\"text\":\"50\",\"x\":4.100000000000001,\"y\":2.0992893218813435,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"steelblue\"}},{\"text\":\"-25\",\"x\":8.092500000000001,\"y\":1.9343629150101496,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"crimson\"}},{\"text\":\"0\",\"x\":12.09,\"y\":1.8727207793864187,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"steelblue\"}},{\"text\":\"-25\",\"x\":16.087500000000002,\"y\":1.93436291501015,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"crimson\"}},{\"text\":\"50\",\"x\":20.08,\"y\":2.099289321881344,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"steelblue\"}},{\"text\":\"106\",\"x\":6.112500000000001,\"y\":2.0205761184457467,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"steelblue\"}},{\"text\":\"35\",\"x\":10.1125,\"y\":1.902291847198284,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"steelblue\"}},{\"text\":\"35\",\"x\":14.0675,\"y\":1.9022918471982844,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"steelblue\"}},{\"text\":\"106\",\"x\":18.067500000000003,\"y\":2.0205761184457467,\"xref\":\"x\",\"yref\":\"y\",\"showarrow\":false,\"font\":{\"color\":\"steelblue\"}}]}}"
            ]
