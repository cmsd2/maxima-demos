8e-8,-2.2659843865962915e-8,-2.7057120048263223e-8,-3.107779176170096e-8,-3.472185900627569e-8,-3.798932178198741e-8,-4.088018008883615e-8,-4.3394433926821876e-8,-4.5532083295944613e-8,-4.729312819620435e-8,-4.8677568627601104e-8,-4.968540459013477e-8,-5.031663608380555e-8,-5.057126310861334e-8,-5.044928566455812e-8,-4.9950703751639914e-8,-4.90755173698587e-8,-4.78237265192145e-8,-4.6195331199707453e-8,-4.424609235392496e-8,-4.226102081377693e-8,-4.028021772833563e-8,-3.830368309760107e-8,-3.6331416921573246e-8,-3.4363419200252154e-8,-3.2399689933637794e-8,-3.044022912173018e-8,-2.848503676452948e-8,-2.6534112862035337e-8,-2.4587457414247925e-8,-2.264507042116726e-8,-2.0706951882793327e-8,-1.8773101799126128e-8,-1.684352017016567e-8,-1.4918206995912118e-8,-1.299716227636513e-8,-1.1080386011524877e-8,-9.167878201391365e-9,-7.259638845964588e-9,-5.355667945244548e-9,-3.455965499231243e-9,-1.5605315079246757e-9,3.3063402867515526e-10,2.202939470008997e-9,4.005550554424565e-9,5.7341120300559405e-9,7.388623896903125e-9,8.969086154966137e-9,1.0475498804244942e-8,1.190786184473955e-8,1.3266175276449863e-8,1.4550439099376108e-8,1.5760653313518154e-8,1.6896817918876012e-8,1.7958932915449602e-8,1.8946998303239086e-8,1.986101408224438e-8,2.070098025246549e-8,2.1466896813902398e-8,2.215876376655513e-8,2.277658111042367e-8,2.3320348845507962e-8,2.3790066971808124e-8,2.4185735489324095e-8,2.4507354398055874e-8,2.4754923698003463e-8,2.4928443389166868e-8,2.5027913471546077e-8,2.5053333945141087e-8,2.500470480995192e-8,2.4882026065978572e-8,2.4685297713221023e-8,2.4414519751679285e-8,2.4069692181353358e-8,2.365081500224324e-8,2.3157888214348935e-8,2.2590911817670436e-8,2.1949885812207807e-8,2.1234810197960934e-8,2.044568497492987e-8,1.9582510143114617e-8,1.8645285702515174e-8],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"royalblue\",\"width\":2},\"name\":\"Trajectory\"},{\"x\":[180.0],\"y\":[0.0],\"type\":\"scatter\",\"mode\":\"markers\",\"marker\":{\"color\":\"tomato\",\"size\":10},\"name\":\"Start (hanging)\"},{\"x\":[0.0],\"y\":[0.0],\"type\":\"scatter\",\"mode\":\"markers\",\"marker\":{\"color\":\"forestgreen\",\"size\":10},\"name\":\"Target (upright)\"}],\"layout\":{\"title\":{\"text\":\"Phase Portrait: Swing-Up (u_max = 12)\"},\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"theta (deg)\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"omega (deg/s)\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": "### Still not upright — why?\n\nThe torque limit is no longer the bottleneck ($u_{\\max} = 12 > mgl = 9.81$), yet the pendulum settles at $\\theta^* \\approx 27°$. The problem is the **policy structure**.\n\nNear upright ($\\theta \\approx 0$), $\\cos\\theta \\approx 1$, so the policy becomes:\n\n$$u \\approx w_1\\theta + w_2 + w_3\\omega$$\n\nThe $w_2$ term is a **constant bias** that shifts the equilibrium away from $\\theta = 0$. Setting $w_2 = 0$ would fix the equilibrium, but then the policy has no mechanism to initiate the swing from hanging ($\\theta = \\pi$). A linear policy in $[\\sin\\theta, \\cos\\theta, \\omega]$ cannot express both \"push hard when hanging\" and \"stop pushing at upright.\"",
      "metadata": {}
    },
    {
      "cell_type": "markdown",
      "source": "## 6. Better Features\n\nReplace $\\cos\\theta$ with $1 - \\cos\\theta$ in the feature vector:\n\n$$u = \\text{clip}(w_1 \\sin\\theta + w_2 (1 - \\cos\\theta) + w_3 \\omega,\\; -u_{\\max},\\; u_{\\max})$$\n\nThis feature is 0 at upright and 2 at hanging, so it provides swing-up torque that **vanishes at the target**. Near upright: $u \\approx w_1 \\theta + w_2 \\theta^2/2 + w_3 \\omega$, which has its equilibrium at $\\theta = 0$.",
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": "/* Cost function with improved features: [sin(theta), 1-cos(theta), omega] */\nsimulate_cost3(w1v, w2v, w3v) := block(\n  [u_expr, rhs1, rhs2, tspan_sim, traj, th_col, om_col, cost_state, n_t],\n  u_expr : max(-u_max, min(u_max,\n    w1v * sin(theta) + w2v * (1 - cos(theta)) + w3v * omega)),\n  rhs1 : omega,\n  rhs2 : -(gv/lp)*sin(theta) - bp*omega + u_expr/(mp*lp^2),\n  tspan_sim : np_linspace(0, 6, 300),\n  traj : np_cvode([rhs1, rhs2], [t, theta, omega],\n                  [float(%pi), 0.0], tspan_sim, 1e-8, 1e-8),\n  th_col : np_slice(traj, all, 1),\n  om_col : np_slice(traj, all, 2),\n  cost_state : np_add(\n    np_pow(np_sub(1.0, np_cos(th_col)), 2),\n    np_scale(0.1, np_pow(om_col, 2))),\n  n_t : first(np_shape(traj)),\n  float(np_mean(cost_state) + 2.0 * np_ref(cost_state, n_t - 1))\n)$\n\ncem_cost3(w) := simulate_cost3(np_ref(w, 0), np_ref(w, 1), np_ref(w, 2))$\n\nnp_seed(42)$\n[best_w3, cost_history3] : np_cem(cem_cost3, 3,\n  n_samples=50, n_elites=10, n_gens=50, sigma0=5.0, sigma_min=0.3)$\n\ncem_mu3 : np_to_list(best_w3)$\nprint(\"Improved policy: w =\",\n  map(lambda([x], float(round(x * 100) / 100)), cem_mu3))$\nprint(\"Final cost:\", last(np_to_list(cost_history3)))$",
      "metadata": {},
      "execution_count": 11,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Improved policy: w = [9.66,-22.93,-10.89]\nFinal cost: 0.45249205931788594"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": "/* Simulate improved policy */\nw1_3 : cem_mu3[1]$  w2_3 : cem_mu3[2]$  w3_3 : cem_mu3[3]$\nu_3 : max(-u_max, min(u_max,\n  w1_3 * sin(theta) + w2_3 * (1 - cos(theta)) + w3_3 * omega))$\n\ntraj3 : np_cvode([omega, -(gv/lp)*sin(theta) - bp*omega + u_3/(mp*lp^2)],\n                  [t, theta, omega],\n                  [float(%pi), 0.0], tspan_eval, 1e-8, 1e-8)$\n\nt3 : np_to_list(np_slice(traj3, all, 0))$\nth3 : np_to_list(np_slice(traj3, all, 1))$\nom3 : np_to_list(np_slice(traj3, all, 2))$\n\n/* Plot angular error from upright: acos(cos(theta)) is always in [0, pi],\n   giving shortest angular distance to the nearest upright position. */\nerr_deg(a) := acos(cos(a)) * 180 / float(%pi)$\n\nax_draw2d(\n  line_width = 2,\n  color = royalblue,\n  name = \"Improved policy\",\n  lines(t3, map(err_deg, th3)),\n  color = \"#aaa\",\n  dash = \"dash\",\n  name = \"Uncontrolled\",\n  lines(t_eval, map(err_deg, th_free_list)),\n  title = \"Angular Error from Upright\",\n  xlabel = \"Time (s)\",\n  ylabel = \"Error (deg)\",\n  grid = true\n)$",
      "metadata": {},
      "execution_count": 12,
      "outputs": [
        {
          "data": {
            "application/x-maxima-plotly": [
