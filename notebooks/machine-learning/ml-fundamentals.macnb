74,0.12940078871019858,0.12916347662060382,0.128929072597835,0.12869752403387136,0.12846877959698927,0.12824278919284973,0.12801950392701417,0.1277988760688263,0.12758085901660257,0.1273654072640758,0.12715247636803895,0.12694202291713946,0.12673400450177524,0.12652837968504893,0.1263251079747346,0.12612414979621756,0.1259254664663669,0.12572902016830315,0.1255347739270264,0.12534269158586825,0.1251527377837381,0.12496487793312987,0.12477907819886119,0.12459530547751527,0.12441352737755947,0.12423371220011376,0.12405582892034478,0.12387984716946139,0.1237057372172887,0.12353346995539992,0.12336301688078415,0.12319435008003028,0.12302744221400903,0.12286226650303328,0.12269879671248037,0.12253700713885901,0.122376872596305,0.12221836840348993,0.12206147037092932,0.1219061547886738,0.12175239841437194,0.12160017846169079,0.12144947258908098,0.12130025888887555,0.12115251587671023,0.12100622248125399,0.12086135803424006,0.12071790226078563,0.12057583526999267,0.120435137545818,0.12029578993820511,0.12015777365446809,0.12002107025092092,0.11988566162474093],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"darkred\",\"width\":2},\"name\":\"lines\"}],\"layout\":{\"title\":{\"text\":\"Logistic Regression: Cross-Entropy Loss\"},\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"Iteration\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"Loss\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
