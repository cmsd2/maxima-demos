5,1.3231672960007272,1.3230971794002886,1.323027411304447,1.3229579899809751,1.3228889137062636,1.3228201807652729,1.322751789451497,1.3226837380669125,1.3226160249219403,1.3225486483354,1.322481606634471,1.322414898154647,1.3223485212396966,1.3222824742416224,1.3222167555206163,1.3221513634450244,1.3220862963912992,1.3220215527439674,1.3219571308955824,1.3218930292466884,1.3218292462057786,1.3217657801892597,1.3217026296214058,1.3216397929343249,1.3215772685679184,1.3215150549698405,1.3214531505954623,1.3213915539078318,1.3213302633776378,1.3212692774831671,1.321208594710273,1.321148213552332,1.3210881325102122,1.3210283500922309,1.3209688648141193,1.320909675198987,1.3208507797772842,1.3207921770867634,1.3207338656724488,1.3206758440865922,1.3206181108886446,1.3205606646452144,1.320503503930037,1.3204466273239337,1.3203900334147827,1.3203337207974797,1.320277688073903,1.3202219338528833,1.3201664567501616,1.3201112553883623,1.3200563283969564,1.3200016744122234,1.3199472920772237,1.3198931800417624,1.3198393369623544,1.3197857615021913,1.3197324523311116,1.3196794081255643,1.3196266275685749,1.3195741093497175,1.3195218521650778,1.3194698547172243,1.3194181157151694,1.3193666338743493,1.3193154079165799,1.3192644365700312,1.3192137185691952,1.3191632526548536,1.3191130375740467,1.319063072080043,1.319013354932307,1.31896388489647,1.3189146607442972,1.3188656812536599,1.3188169452085035,1.3187684513988174,1.318720198620605,1.3186721856758536,1.3186244113725063,1.3185768745244306,1.3185295739513885,1.3184825084790102,1.3184356769387617,1.3183890781679166,1.3183427110095285,1.3182965743124009,1.3182506669310596,1.3182049877257231,1.318159535562277,1.3181143093122412,1.3180693078527457,1.3180245300665019,1.3179799748417742,1.317935641072353,1.3178915276575263,1.3178476335020533,1.3178039575161375,1.317760498615399,1.317717255720846,1.3176742277588525,1.3176314136611256,1.3175888123646853,1.3175464228118334,1.3175042439501277,1.3174622747323599,1.3174205141165247,1.3173789610657958,1.3173376145485012,1.3172964735380954,1.3172555370131378,1.3172148039572618,1.317174273359154,1.3171339442125276,1.3170938155160974,1.317053886273553,1.3170141554935404,1.3169746221896268,1.316935285380289,1.3168961440888782,1.3168571973435994,1.3168184441774906,1.316779883628394,1.316741514738935,1.316703336556496,1.3166653481331965,1.3166275485258654,1.3165899367960212,1.3165525120098442,1.3165152732381595,1.316478219556409,1.316441350044628,1.316404663787429,1.3163681598739698,1.3163318373979374,1.3162956954575242,1.316259733155402,1.3162239495987065,1.3161883438990094,1.3161529151722968,1.3161176625389512,1.3160825851237257,1.316047682055723,1.3160129524683768,1.3159783954994269,1.315944010290897,1.3159097959890775,1.3158757517445006,1.3158418767119229,1.3158081700502993,1.3157746309227665,1.3157412584966206,1.3157080519432967,1.3156750104383483,1.3156421331614256,1.3156094192962562,1.3155768680306263,1.315544478556359,1.315512250069293,1.3154801817692658,1.3154482728600891,1.3154165225495356,1.315384930049312,1.3153534945750456,1.3153222153462618,1.3152910915863651,1.3152601225226186,1.3152293073861288,1.3151986454118227,1.3151681358384284,1.315137777908461,1.315107570868197,1.3150775139676623,1.3150476064606074,1.3150178476044951,1.314988236660477,1.3149587728933778,1.3149294555716753,1.3149002839674842,1.314871257356535],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"darkorange\",\"width\":2},\"name\":\"lines\"}],\"layout\":{\"title\":{\"text\":\"Training Loss (MSE/2)\"},\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"Iteration\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"Loss\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": "## 2. Logistic Regression\n\n### Symbolic Phase: Sigmoid and Cross-Entropy Gradient\n\nThe sigmoid function $\\sigma(z) = \\frac{1}{1 + e^{-z}}$ is the key building block. Its derivative has a remarkably clean form:",
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": "/* Symbolic sigmoid and its derivative */\nsigma(z) := 1 / (1 + exp(-z))$\n\nsigma_deriv : diff(sigma(z), z);\nsigma_deriv_simplified : ratsimp(sigma_deriv);",
      "metadata": {},
      "execution_count": 10,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "%e^-z/(%e^-z+1)^2"
          ]
        },
        {
          "data": {
            "text/latex": [
              "{{e^{z}}\\over{e^{2\\,z}+2\\,e^{z}+1}}"
            ]
          },
          "execution_count": 10,
          "metadata": {},
          "output_type": "execute_result"
        }
      ]
    },
    {
      "cell_type": "code",
      "source": "/* Verify: sigma'(z) = sigma(z) * (1 - sigma(z)) */\nis(ratsimp(sigma_deriv - sigma(z) * (1 - sigma(z))) = 0);",
      "metadata": {},
      "execution_count": 11,
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\mathbf{true}"
            ]
          },
          "execution_count": 11,
          "metadata": {},
          "output_type": "execute_result"
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": "The binary cross-entropy loss for one sample is:\n\n$$\\ell_i = -\\left[ y_i \\log \\sigma(z_i) + (1 - y_i) \\log(1 - \\sigma(z_i)) \\right]$$\n\nwhere $z_i = w_0 + w_1 x_{i1} + w_2 x_{i2}$. The gradient of the loss with respect to $w$ turns out to be:\n\n$$\\nabla_w L = \\frac{1}{N} X^T (\\sigma(Xw) - y)$$\n\nwhich has the same form as linear regression but with $\\sigma(Xw)$ replacing $Xw$.",
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": "/* Symbolic verification: gradient of cross-entropy */\nell(z, yi) := -(yi * log(sigma(z)) + (1 - yi) * log(1 - sigma(z)))$\n\n/* d(ell)/dz simplifies to sigma(z) - y */\ndell_dz : diff(ell(z, yi), z)$\nratsimp(dell_dz);",
      "metadata": {},
      "execution_count": 12,
      "outputs": [
        {
          "data": {
            "text/latex": [
              "-\\left({{\\left(e^{z}+1\\right)\\,{\\it yi}-e^{z}}\\over{e^{z}+1}}\\right)"
            ]
          },
          "execution_count": 12,
          "metadata": {},
          "output_type": "execute_result"
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": "The symbolic computation confirms: $\\frac{\\partial \\ell}{\\partial z} = \\sigma(z) - y$, so the full gradient is $\\nabla_w L = \\frac{1}{N} X^T (\\hat{y} - y)$.\n\n### Numeric Phase: Binary Classification",
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": "/* Generate 2D binary classification data */\nn_class : 60$\nn_total : 2 * n_class$\n\n/* Class 0: centred at (-1, -1) */\nx0_1 : np_add(np_randn([n_class]), -1.0)$\nx0_2 : np_add(np_randn([n_class]), -1.0)$\n\n/* Class 1: centred at (1.5, 1.5) */\nx1_1 : np_add(np_randn([n_class]), 1.5)$\nx1_2 : np_add(np_randn([n_class]), 1.5)$\n\n/* Stack features into design matrix [n_total, 3] with bias column */\nX0 : np_hstack(np_ones([n_class, 1]),\n               np_reshape(x0_1, [n_class, 1]),\n               np_reshape(x0_2, [n_class, 1]))$\nX1 : np_hstack(np_ones([n_class, 1]),\n               np_reshape(x1_1, [n_class, 1]),\n               np_reshape(x1_2, [n_class, 1]))$\nX_lr : np_vstack(X0, X1)$\n\n/* Labels */\ny_lr : np_reshape(\n  ndarray(append(makelist(0.0, i, 1, n_class), makelist(1.0, i, 1, n_class))),\n  [n_total, 1]\n)$\n\nprint(\"Data shape:\", np_shape(X_lr), \"Labels:\", np_shape(y_lr))$",
      "metadata": {},
      "execution_count": 13,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Data shape: [120,3] Labels: [120,1]"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": "/* Logistic regression via gradient descent */\nw_lr : np_zeros([3, 1])$\nlr_rate : 0.1$\nlr_iters : 200$\nlr_losses : []$\n\nfor iter : 1 thru lr_iters do block(\n  z : np_matmul(X_lr, w_lr),\n  p : np_sigmoid(z),\n  /* Cross-entropy loss (with clipping for stability) */\n  p_safe : np_clip(p, 1.0e-10, 1.0 - 1.0e-10),\n  loss : -np_mean(np_add(\n    np_mul(y_lr, np_log(p_safe)),\n    np_mul(np_sub(1.0, y_lr), np_log(np_sub(1.0, p_safe)))\n  )),\n  lr_losses : append(lr_losses, [loss]),\n  /* Gradient: X^T (p - y) / N */\n  grad : np_scale(1.0 / n_total, np_matmul(np_transpose(X_lr), np_sub(p, y_lr))),\n  w_lr : np_sub(w_lr, np_scale(lr_rate, grad))\n)$\n\nw0 : np_ref(w_lr, 0, 0)$\nw1 : np_ref(w_lr, 1, 0)$\nw2 : np_ref(w_lr, 2, 0)$\nprint(\"Learned weights: w0 =\", w0, \", w1 =\", w1, \", w2 =\", w2)$\nprint(\"Final loss:\", last(lr_losses))$",
      "metadata": {},
      "execution_count": 14,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Learned weights: w0 = -0.3209442034954729 , w1 = 1.426959575507412 , w2 =\n                     1.7983485497021112\nFinal loss: 0.11988566162474093"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": "### One-liner with np_minimize\n\nAgain, the manual loop can be replaced by `np_minimize`. The L-BFGS optimizer finds the same solution in fewer iterations:",
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": "/* Cross-entropy cost and gradient as named functions */\nlr_cost(w) := block([z, p, p_safe],\n  z : np_matmul(X_lr, w),\n  p : np_sigmoid(z),\n  p_safe : np_clip(p, 1.0e-10, 1.0 - 1.0e-10),\n  -np_mean(np_add(\n    np_mul(y_lr, np_log(p_safe)),\n    np_mul(np_sub(1.0, y_lr), np_log(np_sub(1.0, p_safe)))\n  )))$\n\nlr_grad(w) := block([z, p],\n  z : np_matmul(X_lr, w),\n  p : np_sigmoid(z),\n  np_scale(1.0 / n_total, np_matmul(np_transpose(X_lr), np_sub(p, y_lr))))$\n\n[w_lr_opt, lr_loss_opt, lr_conv] : np_minimize(lr_cost, lr_grad, np_zeros([3, 1]))$\nprint(\"np_minimize weights:\",\n      np_ref(w_lr_opt, 0, 0), np_ref(w_lr_opt, 1, 0), np_ref(w_lr_opt, 2, 0))$\nprint(\"Loss:\", lr_loss_opt, \"  Converged:\", lr_conv)$\n\n/* Use L-BFGS solution for subsequent analysis */\nw_lr : w_lr_opt$\nw0 : np_ref(w_lr, 0, 0)$\nw1 : np_ref(w_lr, 1, 0)$\nw2 : np_ref(w_lr, 2, 0)$",
      "metadata": {},
      "execution_count": 15,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "np_minimize weights: -0.9692651930489281 2.5312872732316376 2.9080216566856834\nLoss: 0.09747425200260094   Converged: true"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": "/* Compute accuracy */\npred_probs : np_sigmoid(np_matmul(X_lr, w_lr))$\npred_labels : np_where(np_greater(pred_probs, 0.5), 1.0, 0.0)$\ncorrect : np_sum(np_equal(pred_labels, y_lr))$\naccuracy : correct / n_total * 100$\nprint(\"Accuracy:\", accuracy, \"%\")$",
      "metadata": {},
      "execution_count": 16,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Accuracy: 96.66666666666667 %"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": "/* Plot data with decision boundary */\nx0_1_list : np_to_list(x0_1)$\nx0_2_list : np_to_list(x0_2)$\nx1_1_list : np_to_list(x1_1)$\nx1_2_list : np_to_list(x1_2)$\n\nax_draw2d(\n  color = \"steelblue\", marker_size = 6, name = \"Class 0\",\n  points(x0_1_list, x0_2_list),\n  color = \"darkorange\", marker_size = 6, name = \"Class 1\",\n  points(x1_1_list, x1_2_list),\n  color = \"red\", line_width = 2, name = \"Decision boundary\",\n  implicit(w0 + w1 * u + w2 * v = 0, u, -4, 5, v, -4, 5),\n  title = \"Logistic Regression: Decision Boundary\",\n  xlabel = \"x1\", ylabel = \"x2\", grid = true, showlegend = true\n)$",
      "metadata": {},
      "execution_count": 17,
      "outputs": [
        {
