5,2.2530151338548063,1.1274475381151925,1.2093292823757156,0.7734115701306812,1.1384489466120662,2.049869854661574,1.7677648887125539,1.6394873050343506,0.5630877728007279,0.7293663772863955,3.690922488160708,0.8742682548140428,0.9238818207247779,0.6981743427442162,2.8794654185369724,0.26647082827901625,3.5363749936398694,1.0254735756466962,2.413488310125849,0.8128994115193684,0.8565071507542235,0.6546727614080851,0.5887409135804302,1.1372785031631698,1.5464105329678501,0.43541156019340777,1.8025218316707416,0.8383937058867749,0.6845998294399769,1.3622529787709392,1.1162443484738784,1.8181568264705685,2.0234327542559063,1.1118676965293037,0.9968114383500771,0.8732640576505806,0.8704586123340949,1.045260216932128,1.0720328628885336,2.0927657171864755,1.7883817710638605,0.6245147072717789,0.8298101099531886,0.579375839987358,2.676602632954107,0.9901995746579653,1.5263919406236224,1.3110369667978201,2.2134460141965446,0.464616917736112,0.6534683999186104,1.1449953988128407,0.3499276421326202,1.9390246760799617,1.3289027252926617,0.07955384230844567,0.48883895735776245,1.027039972367205,2.440647030653495,3.528377230375247,4.202592366720218,2.243136972452049,0.8777069766931698,0.556721856036918,1.8614892451701404,1.4828379305249633,0.7038519722708354,2.066992112994033,1.1719443205715971,2.378609905156523,1.2247939693268093,0.6453697729613671,0.9285614544140346,0.37338618850014815,0.6570042171399564,1.4038377986019137,1.484617205233709,0.6888416129006295,1.3433682067701607,1.4049428293407082,2.4733924542093035,2.379602098796258,2.6229065554635507,2.9707068158504093,0.9582337033810814,1.4723593445744896,0.9462769517710106,0.6057044721330298,4.505067816444226],\"type\":\"histogram\",\"marker\":{\"color\":\"steelblue\"},\"name\":\"histogram\"}],\"layout\":{\"title\":{\"text\":\"Gamma MLE: Histogram of Data\"},\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"Count\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": "## 3. Fisher Information and Confidence Intervals [S+N]\n\nThe **Fisher information** per observation is the negative expected Hessian of the log-likelihood:\n$$\\mathcal{I}(\\theta)_{jk} = -E\\!\\left[\\frac{\\partial^2 \\ell_i}{\\partial \\theta_j \\partial \\theta_k}\\right]$$\n\nFor the Normal case, we derive it symbolically from the log-likelihood in Section 1.",
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": "/* Hessian of per-observation log-likelihood */\nH_11 : diff(ll_i(mu, sigma, x[i]), mu, 2);\nH_12 : diff(diff(ll_i(mu, sigma, x[i]), mu), sigma);\nH_22 : diff(ll_i(mu, sigma, x[i]), sigma, 2);",
      "metadata": {},
      "execution_count": 8,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "-(1/sigma^2)\n-((2*(x[i]-mu))/sigma^3)"
          ]
        },
        {
          "data": {
            "text/latex": [
              "{{1}\\over{\\sigma^2}}-{{3\\,\\left(x_{i}-\\mu\\right)^2}\\over{\\sigma^4}}"
            ]
          },
          "execution_count": 8,
          "metadata": {},
          "output_type": "execute_result"
        }
      ]
    },
    {
      "cell_type": "code",
      "source": "/* Fisher information: -E[H]\n   Using E[(x-mu)^2] = sigma^2, E[x-mu] = 0 */\nI_11 : ratsimp(-subst([(x[i] - mu)^2 = sigma^2, x[i] - mu = 0], H_11));\nI_22 : ratsimp(-subst([(x[i] - mu)^2 = sigma^2, x[i] - mu = 0], H_22));\nprint(\"Fisher information per observation:\")$\nprint(\"  I_11 =\", I_11, \", I_22 =\", I_22)$\n\n/* Standard errors: se = 1/sqrt(n * I_jj) */\nse_mu : 1 / sqrt(n_norm * float(subst(sigma = sigma_cf, I_11)))$\nse_sigma : 1 / sqrt(n_norm * float(subst(sigma = sigma_cf, ratsimp(I_22))))$\nprint(\"95% CI for mu:\", mu_cf, \"+/-\", 1.96*se_mu)$\nprint(\"95% CI for sigma:\", sigma_cf, \"+/-\", 1.96*se_sigma)$",
      "metadata": {},
      "execution_count": 9,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "1/sigma^2\n2/sigma^2\nFisher information per observation:\n  I_11 = 1/sigma^2 , I_22 = 2/sigma^2\n95% CI for mu: 3.1660450641148192 +/- 0.2793024764233935\n95% CI for sigma: 2.0152721947058914 +/- 0.19749667508117738"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": "## 4. Logistic Regression as MLE [S+N]\n\nLogistic regression is a GLM where the likelihood for binary $y_i \\in \\{0,1\\}$ is\n$$\\ell(\\mathbf{w}) = \\sum_{i=1}^n \\bigl[ y_i \\ln\\sigma(\\mathbf{w}^T\\mathbf{x}_i) + (1-y_i)\\ln(1 - \\sigma(\\mathbf{w}^T\\mathbf{x}_i)) \\bigr]$$\n\nwhere $\\sigma(z) = 1/(1+e^{-z})$ is the sigmoid. The gradient simplifies beautifully:",
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": "/* Sigmoid and its derivative */\nsigmoid_sym(z) := 1 / (1 + exp(-z))$\nratsimp(diff(sigmoid_sym(z), z));",
      "metadata": {},
      "execution_count": 10,
      "outputs": [
        {
          "data": {
            "text/latex": [
              "{{e^{z}}\\over{e^{2\\,z}+2\\,e^{z}+1}}"
            ]
          },
          "execution_count": 10,
          "metadata": {},
          "output_type": "execute_result"
        }
      ]
    },
    {
      "cell_type": "code",
      "source": "/* Generate 2D classification data */\nn_lr : 100$\nx1_lr : np_randn([n_lr])$\nx2_lr : np_randn([n_lr])$\n\n/* True model: P(y = 1) = sigmoid(1 + 2*x1 - 1.5*x2).  Each label is drawn\n   from that probability.  Thresholding at 0 instead would separate the\n   classes perfectly, and then the MLE does not exist. */\nz_true : np_add(1.0, np_add(np_scale(2.0, x1_lr), np_scale(-1.5, x2_lr)))$\ny_lr : np_map(lambda([v], if v > 0 then 1.0 else 0.0),\n              np_sub(np_sigmoid(z_true), np_rand([n_lr])))$\n\n/* Design matrix: [1, x1, x2] */\nX_lr : np_hstack(np_ones([n_lr, 1]),\n                 np_reshape(x1_lr, [n_lr, 1]),\n                 np_reshape(x2_lr, [n_lr, 1]))$\ny_lr_col : np_reshape(y_lr, [n_lr, 1])$\n\n/* Numerically stable sigmoid: clip input to avoid exp overflow */\nstable_sigmoid(z) := np_div(1.0, np_add(1.0, np_exp(np_neg(np_clip(z, -500.0, 500.0)))))$\n\n/* Negative log-likelihood */\nlr_nll(w) := block([z, p, p_safe],\n  z : np_matmul(X_lr, w),\n  p : stable_sigmoid(z),\n  p_safe : np_clip(p, 1.0e-10, 1.0 - 1.0e-10),\n  -np_mean(np_add(\n    np_mul(y_lr_col, np_log(p_safe)),\n    np_mul(np_sub(1.0, y_lr_col),\n           np_log(np_sub(1.0, p_safe))))))$\n\nlr_grad(w) := block([z, p],\n  z : np_matmul(X_lr, w),\n  p : stable_sigmoid(z),\n  np_scale(1.0 / n_lr,\n    np_matmul(np_transpose(X_lr), np_sub(p, y_lr_col))))$\n\n[w_lr, nll_lr, conv_lr] : np_minimize(lr_nll, lr_grad, np_zeros([3, 1]))$\nprint(\"Fitted w =\", np_to_list(np_flatten(w_lr)))$\nprint(\"True:  w = [1, 2, -1.5]\")$",
      "metadata": {},
      "execution_count": 11,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Fitted w = [0.425911653811777,1.717367451856681,-1.3097725868978887]\nTrue:  w = [1, 2, -1.5]"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": "/* Decision boundary: w0 + w1*x1 + w2*x2 = 0  =>  x2 = -(w0 + w1*x1)/w2 */\nw0 : np_ref(w_lr, 0, 0)$  w1 : np_ref(w_lr, 1, 0)$  w2 : np_ref(w_lr, 2, 0)$\n\n/* Separate classes using boolean mask + extract */\nmask_pos : np_greater(y_lr, 0.5)$\nmask_neg : np_logical_not(mask_pos)$\n\nax_draw2d(\n  color=\"blue\", marker_size=5, name=\"Class 1\",\n  points(np_to_list(np_extract(mask_pos, x1_lr)),\n         np_to_list(np_extract(mask_pos, x2_lr))),\n  color=\"red\", marker_size=5, name=\"Class 0\",\n  points(np_to_list(np_extract(mask_neg, x1_lr)),\n         np_to_list(np_extract(mask_neg, x2_lr))),\n  color=\"black\", line_width=2, name=\"Decision boundary\",\n  explicit(-(w0 + w1*u) / w2, u, -3, 3),\n  title=\"Logistic Regression MLE\",\n  xlabel=\"x1\", ylabel=\"x2\", grid=true, showlegend=true\n)$",
      "metadata": {},
      "execution_count": 12,
      "outputs": [
        {
          "data": {
            "application/x-maxima-plotly": [
