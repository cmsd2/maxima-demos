,6.269771579203184,-0.3379262211097198,6.222807598004946,5.927468290879112,4.090294927060973,4.5662790527943855,-0.33420641250482985,5.177274366650333,4.181050374909085,3.5840595468128735,4.759174289709714,5.741656066021788,1.951828910291553,2.2089724983538392,2.8695247844387617,2.4476338818373047,7.61533339581368,6.214789846877478,5.125707359227177,-0.9654857460666504,1.2209189575741448,-0.7396387544730727,4.7739446898812545,2.3260086273045295,5.491133385423257,6.689737300841626,6.2235191379016745,2.2655678065724962,4.400188841393641,2.508652734287571,4.680265068353052,0.6060350563733858,1.552130758245493,4.897013411129707,3.8134826693628785,2.389616220330598,0.7075488527082818,1.0760579197732425,3.201504602086251,7.003066130975342,0.21396288912491945,1.3654346166699378,1.6807958249527435,4.730943180117933,3.052668105518568,6.257765411197342,3.826338629928589,3.873928254980037,4.504552045699583,1.8697385431064304,4.14678323220139,3.962386263650798,3.5337691058384646,2.424035039802721,4.9491736775046595,-1.326387165603256,6.512115085535765,3.782659278354095,4.537437953568021,-0.6511108284729477,1.731164458438831,0.6722252209140662,1.0814272448898214,2.396378653416275,4.7387243064762075,3.5271635510254074,3.9592447209573156,4.023498738196778,3.2839973842094965,3.7632793185151137,2.1465486612529774,0.9697978343119824,2.9395675978098827,3.427159737186884,3.9665173503805367,2.8086537095770048,0.08892114505670756,3.748463618350673,2.0263056205721193,1.2792417758210073,3.4833891189725366,3.560441815050914,4.850354371247029,3.819592277996446,2.4235989579757335,2.663733458305885,5.7998175697078,0.8199146236492445,5.151315108071634,4.8489354245265295,2.0468858277124933,4.281256395083928,5.743547467651258,1.611019765041121],\"type\":\"histogram\",\"marker\":{\"color\":\"steelblue\"},\"name\":\"histogram\"}],\"layout\":{\"title\":{\"text\":\"Normal MLE: Histogram of Data\"},\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"Count\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
          },
          "metadata": {},
