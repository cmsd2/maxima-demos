\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"y\"},\"range\":[-3.0,6.0],\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
