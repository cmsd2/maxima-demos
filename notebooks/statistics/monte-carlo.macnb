0.811051245481528,0.4885800411501322,0.9669383733425625,0.9647230079261138,0.8974810025848048,0.9413831913510895,0.7358219222567908,0.9071131867473021,0.8464789239096964,0.9124854516362564,0.8204105600201719,0.6711775095834669,0.7612924401163432,0.818291612181461,0.9332268775466066,0.9556936193365082,0.9285343448931065,0.9325136732654975,0.8035705086407734,0.21147006088205766,0.5559161464574902,0.9871543985744784,0.4007873195998519,0.9970528903727351,0.9355794663105197,0.9948227278566595,0.8740478279714501,0.9993814681294646,0.927100523310942,0.9669862612554692,0.7939265210976347,0.5831702717191993,0.6534475664709922,0.5239248811249271,0.8538812886097615,0.9770061176194869,0.6492499399318201,0.7245847588912193,0.6850835981347148,0.8930159257019941,0.9724173612527558,0.9914967498380554,0.860662699329364,0.7176574339424644,0.9968147287648321,0.9348205451015101,0.5224685064024188,0.864091426666264,0.6532743971105934,0.942792838107922,0.9814475534470408,0.48205857713327216,0.5920737546648898,0.9095073583295654,0.9891318435518182,0.7221804761435635,0.7327666145435867,0.9868840694083376,0.8929158240820523,0.9649375078891931,0.8348133770300139,0.864009280718687,0.6849327968611076,0.8042670963362617,0.7096027251447108,0.9056404928321349,0.524187471541399,0.8176544386482556,0.9003371379396716,0.43173950590018095,0.7171578626559036,0.8716784573898584,0.9270030359280244,0.992977710293669,0.37897781643011297,0.3274116238782787,0.6302898959764751,0.5265869345765388,0.7799201334111334,0.6543567256890059,0.6791407286792497,0.8516349298894006,0.8976017797920315,0.9853277758145182,0.7540771087905451,0.6073966251043104,0.8866396394418845],\"type\":\"scatter\",\"mode\":\"markers\",\"marker\":{\"color\":\"red\",\"size\":2},\"name\":\"Outside\"}],\"layout\":{\"title\":{\"text\":\"Pi Estimate: 3.1444 (N=10000)\"},\"width\":700,\"height\":700,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"y\"},\"scaleanchor\":\"x\",\"scaleratio\":1.0,\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": "## Convergence of the Pi Estimate\n\nAs $N$ increases, the Monte Carlo estimate converges to the true value.\nThe standard error decreases as $O(1/\\sqrt{N})$, which is the hallmark\nconvergence rate of Monte Carlo methods -- independent of dimension.",
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": "/* Run the pi estimation for increasing sample sizes */\nsample_sizes : [100, 500, 1000, 5000, 10000, 50000]$\n\npi_estimates : makelist(\n  block([pts, xx, yy, dd, cc],\n    pts : np_rand([sample_sizes[i], 2]),\n    xx : np_col(pts, 0),\n    yy : np_col(pts, 1),\n    dd : np_sqrt(np_add(np_pow(xx, 2), np_pow(yy, 2))),\n    cc : np_sum(np_less_equal(dd, 1.0)),\n    4.0 * cc / sample_sizes[i]\n  ),\n  i, 1, length(sample_sizes)\n)$\n\nfor i: 1 thru length(sample_sizes) do\n  print(sconcat(\"N = \", string(sample_sizes[i]),\n                \"  estimate = \", string(pi_estimates[i]),\n                \"  error = \", string(abs(pi_estimates[i] - float(%pi)))))$",
      "metadata": {},
      "execution_count": 4,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "N = 100  estimate = 3.12  error = 0.02159265358979301\nN = 500  estimate = 3.056  error = 0.08559265358979307\nN = 1000  estimate = 3.176  error = 0.03440734641020704\nN = 5000  estimate = 3.1552  error = 0.013607346410206667\nN = 10000  estimate = 3.1468  error = 0.0052073464102067035\nN = 50000  estimate = 3.15088  error = 0.009287346410206787"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": "/* Plot convergence: estimate vs N, with true pi as reference */\nax_draw2d(\n  color=blue, name=\"MC estimate\",\n  points(sample_sizes, pi_estimates),\n  color=red, dash=\"dash\", name=\"true pi\",\n  lines([[first(sample_sizes), float(%pi)],\n         [last(sample_sizes), float(%pi)]]),\n  title=\"Convergence of Pi Estimate\",\n  xlabel=\"N (sample size)\", ylabel=\"Estimate\",\n  grid=true\n)$",
      "metadata": {},
      "execution_count": 5,
      "outputs": [
        {
          "data": {
            "application/x-maxima-plotly": [
              "{\"data\":[{\"x\":[100.0,500.0,1000.0,5000.0,10000.0,50000.0],\"y\":[3.12,3.056,3.176,3.1552,3.1468,3.15088],\"type\":\"scatter\",\"mode\":\"markers\",\"marker\":{\"color\":\"blue\",\"size\":6},\"name\":\"MC estimate\"},{\"x\":[100.0,50000.0],\"y\":[3.141592653589793,3.141592653589793],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"red\",\"width\":2,\"dash\":\"dash\"},\"name\":\"true pi\"}],\"layout\":{\"title\":{\"text\":\"Convergence of Pi Estimate\"},\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"N (sample size)\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"Estimate\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": "## Central Limit Theorem\n\nThe **Central Limit Theorem** states that the mean of $n$ i.i.d. random\nvariables converges to a normal distribution as $n \\to \\infty$,\nregardless of the underlying distribution.\n\nWe demonstrate this with the uniform distribution on $[0,1)$: take many\nsamples of size 30, compute the mean of each, and observe that the\nhistogram of sample means is approximately Gaussian -- even though the\nindividual values are uniformly distributed.",
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": "/* Generate 2000 samples, each of size 30 */\nn_samples : 2000$\nsample_size : 30$\n\n/* Each row is one sample of 30 uniform values */\nsamples : np_rand([n_samples, sample_size])$\n\n/* Compute mean of each row (sample) */\nsample_means : np_mean(samples, 1)$\n\nprint(\"Mean of sample means:\", np_mean(sample_means))$\nprint(\"Std dev of sample means:\", np_std(sample_means))$\nprint(\"Theoretical std dev: 1/sqrt(12*30) =\", float(1/sqrt(12*30)))$",
      "metadata": {},
      "execution_count": 6,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Mean of sample means: 0.5002971811133663\nStd dev of sample means: 0.052569099531616044\nTheoretical std dev: 1/sqrt(12*30) = 0.05270462766947299"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": "/* Histogram of sample means -- should look Gaussian */\nax_draw2d(\n  color=\"steelblue\", nbins=40,\n  ax_histogram(sample_means),\n  title=\"Central Limit Theorem: Distribution of Sample Means\",\n  xlabel=\"Sample Mean\", ylabel=\"Count\",\n  grid=true\n)$",
      "metadata": {},
      "execution_count": 7,
      "outputs": [
        {
          "data": {
