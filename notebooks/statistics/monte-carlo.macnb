55332385275,0.5506756936951749,0.4638366170540904,0.48733858860190726,0.513410342049044,0.6273227294488817,0.5689852898526792,0.38069825454861145,0.6453949185996053,0.40581891853987545,0.4477964938544421,0.5225330852761716,0.4963769019156091,0.5119178828126143,0.4345562918570434,0.5460616742836795],\"type\":\"histogram\",\"marker\":{\"color\":\"steelblue\"},\"nbinsx\":40,\"name\":\"histogram\"}],\"layout\":{\"title\":{\"text\":\"Central Limit Theorem: Distribution of Sample Means\"},\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"Sample Mean\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"Count\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
