728451,-1.7453669633970044,-1.7451110299107644,-1.7448550222039698,-1.7445989402108584,-1.744342783865668,-1.7440865531026375,-1.7438302478560024,-1.7435738680600026,-1.7433174136488765,-1.74306088455686,-1.742804280718192,-1.7425476020671102,-1.7422908485378528,-1.7420340200646574,-1.741777116581762,-1.7415201380234044,-1.7412630843238226,-1.7410059554172552,-1.7407487512379387,-1.7404914717201114,-1.7402341167980115,-1.739976686405877,-1.7397191804779453,-1.7394615989484548,-1.739203941751643,-1.7389462088217487,-1.7386884000930083,-1.7384305154996595,-1.738172554975943,-1.7379145184560938,-1.7376564058743509],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"#dc2626\",\"width\":1},\"name\":\"lines\"}],\"layout\":{\"title\":{\"text\":\"Van der Pol (mu=1000) — Relaxation Oscillation\"},\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"t\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"x\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
