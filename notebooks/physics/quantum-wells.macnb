611669081674,0.24377957848520845,0.2167150701799117,0.1912425917749271,0.1673621432702535,0.1450737246658915,0.12437733596184104,0.10527297715810217,0.08776064825467526,0.07184034925155952,0.05751208014875536,0.044775840946262774,0.03363163164408177,0.024079452242212543,0.016119302740654665,0.009751183139408363,0.004975093438473642,0.0017910336378505003,1.990037375389563e-4,1.990037375389386e-4,0.0017910336378504472,0.004975093438473642,0.009751183139408238,0.016119302740654665,0.02407945224221235,0.03363163164408154,0.044775840946262774,0.05751208014875506,0.07184034925155952,0.08776064825467489,0.10527297715810177,0.12437733596184104,0.14507372466589102,0.1673621432702535,0.19124259177492656,0.21671507017991112,0.24377957848520845,0.2724361166908161,0.30268468479673666,0.3345252828029674,0.3679579107095096,0.402982568516365,0.4395992562235303,0.4778079738310089,0.5176087213387973,0.5590014987468973,0.6019863060553107,0.6465631432640336,0.6927320103730703,0.7404929073824164,0.789845834292074,0.8407907911020455,0.8933277778123262,0.9474567944229209,1.0031778409338246,1.0604909173450399,1.1193960236565694,1.1798931598684077,1.2419823259805605,1.305663521993022,1.370936747905795,1.4378020037188826,1.5062592894322786,1.5763086050459894,1.6479499505600084,1.7211833259743392,1.7960087312889847,1.8724261665039383,1.9504356316192073,2.030037126634784,2.1112306515506725,2.194016206366876,2.2783937910833876,2.3643634057002143,2.4519250502173486,2.541078724634795,2.6318244289525565,2.7241621631706257,2.8180919272890104,2.9136137213077027,3.0107275452267066,3.109433399046026,3.209731282765653,3.311621196385596,3.415103139905846,3.5201771133264073,3.6268431166472848,3.7351011498684694,3.84495121298997,3.956393306011778,4.069427428933897,4.1840535817563325,4.300271764479075,4.418081977102134,4.537484219625499,4.658478492049176,4.78106479437317,4.90524312659747,5.0310134887220865,5.15837588074701,5.2873303026722445,5.4178767544977955,5.550015236223653,5.683745747849828,5.819068289376309,5.955982860803101,6.094489462130211,6.234588093357626,6.37627875448536,6.519561445513398,6.664436166441748,6.810902917270416,6.9589616979993885,7.1086125086286795,7.259855349158276,7.412690219588183,7.567117119918409,7.7231360501489394,7.880747010279789,8.039950000310943,8.200745020242408,8.363132070074192,8.52711114980628,8.692682259438687,8.859845398971398,9.028600568404421,9.198947767737764,9.370886996971409,9.544418256105375,9.719541545139643,9.896256864074225,10.074564212909124],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"black\",\"width\":3},\"name\":\"V(x)\"}],\"layout\":{\"title\":{\"text\":\"Harmonic Oscillator: Matrix (colour) and Exact (dashed)\"},\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"x\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"E, and ψ offset by E\"},\"range\":[0.0,5.5],\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": "## Finite Square Well [S+N]\n\nNow $V = -V_0$ for $|x| < a$ and $V = 0$ outside. A bound state has $-V_0 < E < 0$, oscillates inside with $k = \\sqrt{2(E + V_0)}$ and decays outside as $e^{-\\kappa |x|}$ with $\\kappa = \\sqrt{-2E}$. The potential is symmetric, so the states are even ($\\cos kx$ inside) or odd ($\\sin kx$ inside). Matching $\\psi$ and $\\psi'$ at $x = a$ and dividing out the amplitude gives each condition:",
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": "assume(kap > 0, a > 0)$\nmatch(inner) := block([eqs, sB],\n  eqs : [subst(x = a, inner) = B*exp(-kap*a),\n         subst(x = a, diff(inner, x)) = -kap*B*exp(-kap*a)],\n  sB : solve(eqs[1], B),\n  ratsimp(subst(sB, eqs[2])/subst(x = a, inner)))$\n[even_condition : match(A*cos(k*x)), odd_condition : match(A*sin(k*x))];",
      "metadata": {},
      "execution_count": 13,
      "outputs": [
        {
          "data": {
            "text/latex": [
              "\\left[ -\\left({{k\\,\\sin \\left(a\\,k\\right)}\\over{\\cos \\left(a\\,k\\right)}} \\right)=-{\\it kap} , {{k\\,\\cos \\left(a\\,k\\right)}\\over{\\sin \\left(a\\,k\\right) }}=-{\\it kap} \\right] "
            ]
          },
          "execution_count": 13,
          "metadata": {},
          "output_type": "execute_result"
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": "So $k\\tan ka = \\kappa$ for even states and $-k\\cot ka = \\kappa$ for odd ones. With $z = ka$ and $z_0 = a\\sqrt{2V_0}$ we have $\\kappa a = \\sqrt{z_0^2 - z^2}$, and the conditions become transcendental equations in $z$ alone. Multiplying through by $\\cos z$ or $\\sin z$ removes the poles of $\\tan$ and $\\cot$, so `find_root` can bracket each root in one quarter-period $[j\\pi/2, (j+1)\\pi/2]$: even $j$ gives even states, odd $j$ odd ones. For $V_0 = 15$ and $a = 1$, $z_0 = 5.48$ allows four bound states.",
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": "V0_fw : 15$\na_fw : 1$\nz0 : a_fw*sqrt(2*V0_fw)$\nwell_even(z) := z*sin(z) - sqrt(z0^2 - z^2)*cos(z)$\nwell_odd(z) := z*cos(z) + sqrt(z0^2 - z^2)*sin(z)$\nz_roots : makelist(\n  find_root(if evenp(j) then well_even(z) else well_odd(z), z,\n            float(j*%pi/2) + 1e-9, float(min((j + 1)*%pi/2, z0)) - 1e-12),\n  j, 0, floor(z0/(%pi/2)))$\nE_fw_exact : map(lambda([z], z^2/(2*a_fw^2) - V0_fw), z_roots)$\nprintf(true, \"z0 = ~,4f~%\", float(z0))$\nfor j : 1 thru length(z_roots) do\n  printf(true, \"state ~d (~a): z = ~,6f   E = ~,6f~%\", j - 1,\n         if oddp(j) then \"even\" else \"odd\", z_roots[j], E_fw_exact[j])$",
      "metadata": {},
      "execution_count": 14,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "z0 = 5.4772\nstate 0 (even): z = 1.326230   E = -14.120557\nstate 1 (odd): z = 2.638892   E = -11.518124\nstate 2 (even): z = 3.915858   E = -7.333027\nstate 3 (odd): z = 5.090445   E = -2.043684"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": "The matrix uses the box $[-4, 4]$. The potential jumps at $x = \\pm a$, and a jump that lands on a grid point spoils the second-order accuracy. With $N = 803$ the spacing is $h = 8/804$ and both edges fall exactly halfway between grid points. A misaligned grid of 800 points is shown for contrast.",
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": "fw_levels(N) := block([g : grid(-4, 4, N), Vl],\n  Vl : map(lambda([xv], if abs(xv) < a_fw then -float(V0_fw) else 0.0), g[2]),\n  [g, Vl, eig_lowest(fd_hamiltonian(g[1], Vl), 4)])$\n[g_fw, V_fw, levels_fw] : fw_levels(803)$\n[E_fw, v_fw] : levels_fw$\nE_fw_800 : first(third(fw_levels(800)))$\nprintf(true, \"state   find_root     matrix N=803   difference   matrix N=800   difference~%\")$\nfor j : 1 thru 4 do\n  printf(true, \"~3d ~13,6f ~13,6f ~12,2e ~13,6f ~12,2e~%\", j - 1, E_fw_exact[j],\n         E_fw[j], E_fw[j] - E_fw_exact[j], E_fw_800[j], E_fw_800[j] - E_fw_exact[j])$",
      "metadata": {},
      "execution_count": 15,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "state   find_root     matrix N=803   difference   matrix N=800   difference\n  0    -14.120557    -14.120665     -1.08e-4    -14.118815      1.74e-3\n  1    -11.518124    -11.518632     -5.08e-4    -11.511431      6.69e-3\n  2     -7.333027     -7.334372     -1.35e-3     -7.319185      1.38e-2\n  3     -2.043684     -2.045959     -2.27e-3     -2.024323      1.94e-2"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": "The aligned grid agrees with the transcendental roots to within $3 \\times 10^{-3}$. The misaligned grid of almost the same size is about ten times worse. The wavefunctions bend inside the well and decay outside it, with the highest state reaching furthest into the walls.",
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": "n_first : 0$\n[h_fw, x_fw] : g_fw$\ninside_fw : sublist_indices(x_fw, lambda([xv], abs(xv) <= 3))$\npsi_fw : makelist(to_psi(v_fw[j], h_fw), j, 1, 4)$\nax_draw2d(\n  level_objects(makelist(x_fw[i], i, inside_fw), makelist(V_fw[i], i, inside_fw), E_fw,\n                makelist(makelist(psi_fw[j][i], i, inside_fw), j, 1, 4), 2.0),\n  lines([-3, -1, -1, 1, 1, 3], [0, 0, -15, -15, 0, 0], color = \"black\", dash = \"solid\",\n        line_width = 3, name = \"V(x)\"),\n  title = \"Finite Square Well, V0 = 15, a = 1\",\n  xlabel = \"x\", ylabel = \"E, and ψ offset by E\", yrange = [-16, 1.5])$",
      "metadata": {},
      "execution_count": 16,
      "outputs": [
        {
