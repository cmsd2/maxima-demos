95],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"seagreen\",\"width\":2,\"dash\":\"dash\"},\"name\":\"Newton, L = 4.4\"}],\"layout\":{\"title\":{\"text\":\"Effective Potential, GR (solid) and Newton (dashed)\"},\"showlegend\":true,\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"r / M\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"range\":[-0.1,0.08],\"title\":{\"text\":\"V(r)\"},\"showgrid\":true,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
            ]
          },
          "metadata": {},
