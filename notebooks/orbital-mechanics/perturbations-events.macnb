-0.061342474267213495,-0.061981458374163634,-0.06262044248111377,-0.06325942658806392],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"tomato\",\"width\":2,\"dash\":\"dash\"},\"name\":\"Predicted (linear)\"}],\"layout\":{\"title\":{\"text\":\"RAAN Precession due to J2\"},\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"Time (s)\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"u0394RAAN (rad)\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
