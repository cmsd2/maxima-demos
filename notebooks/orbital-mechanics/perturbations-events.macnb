135.2494947803684,-3089.2980996570864,-3042.858120309297,-2995.93689596412,-2948.5418421306276,-2900.6804494136904,-2852.360282349774,-2803.5889782333215,-2754.374245898093,-2704.7238645124103,-2654.645682368146,-2604.147615632893,-2553.2376471053108,-2501.9238249676805,-2450.214261512348,-2398.1171318575775,-2345.6406726653317,-2292.793180844855,-2239.5830122300504,-2186.018580264901,-2132.1083546845507,-2077.8608601573046,-2023.2846749430355,-1968.3884295441699,-1913.1808053246095,-1857.670533137547,-1801.8663919494245,-1745.7772074383158,-1689.4118505930896,-1632.7792363117214,-1575.8883219821228,-1518.7481060544915,-1461.3676266157659,-1403.7559599556375,-1345.922219113776,-1287.8755524338144,-1229.6251421140787,-1171.1802027344656,-1112.5499797932682,-1053.743748239761,-994.7708109885725,-935.6404974388217,-876.3621619916995,-816.9451825540934,-757.3989590431007,-697.7329118902545,-637.9564805373784,-578.0791219286472,-518.1103090037659,-458.0595291883151,-397.93628287577377,-337.750081913466,-277.5104480870714,-217.2269115971207,-156.90900954019017,-96.56628438835912,-36.20828246433181,24.155447580424415,84.51535628874284,144.86189492184468,205.18551698151296,265.4766797328483,325.72584572588886],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"royalblue\",\"width\":1},\"name\":\"With J2\"},{\"x\":[0.0],\"y\":[0.0],\"type\":\"scatter\",\"mode\":\"markers\",\"marker\":{\"color\":\"seagreen\",\"size\":6},\"name\":\"\"}],\"layout\":{\"title\":{\"text\":\"J2 Perturbation: 10 Orbits (LEO, 45 deg inclination)\"},\"width\":700,\"height\":700,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"scaleanchor\":\"x\",\"scaleratio\":1.0,\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
