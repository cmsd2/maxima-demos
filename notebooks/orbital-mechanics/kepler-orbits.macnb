681127,0.8000000000677281,0.8000000000673361,0.8000000000669453,0.8000000000665597,0.8000000000661791,0.800000000065803,0.8000000000654305,0.8000000000650618,0.8000000000646963,0.8000000000643332,0.8000000000639724,0.8000000000636135,0.800000000063256,0.8000000000628997],\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"color\":\"tomato\",\"width\":2},\"name\":\"Ang. momentum\"}],\"layout\":{\"title\":{\"text\":\"Conservation Laws (Elliptical Orbit)\"},\"width\":700,\"height\":450,\"plot_bgcolor\":\"white\",\"paper_bgcolor\":\"white\",\"xaxis\":{\"title\":{\"text\":\"t\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1},\"yaxis\":{\"title\":{\"text\":\"Value\"},\"gridcolor\":\"#ddd\",\"linecolor\":\"#ddd\",\"linewidth\":1,\"zerolinecolor\":\"black\",\"zerolinewidth\":1}}}"
